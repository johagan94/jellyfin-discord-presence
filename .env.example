# ---------------------------------------------------------------------------
# Copy to ".env" and fill in.  NEVER commit the real .env (it holds secrets).
# ---------------------------------------------------------------------------

# --- Jellyfin (internal address the container uses to poll the API) ---
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=                       # Jellyfin Dashboard -> API Keys -> New
JELLYFIN_USERNAME=                      # whose playback to mirror (or use JELLYFIN_USER_ID)
# JELLYFIN_USER_ID=

# Public, HTTPS, Discord-reachable base URL — ONLY used to fetch poster art.
# Leave blank if Jellyfin is LAN-only; a static logo (STATIC_LARGE_IMAGE) is used instead.
JELLYFIN_PUBLIC_URL=

# --- Discord ---
DISCORD_USER_TOKEN=                     # your user token (self-bot) — see README, keep secret
DISCORD_APP_ID=                         # Developer Portal -> your application -> Application ID
ACTIVITY_NAME=Jellyfin                  # shows as "Watching <name>" / "Listening to <name>"

# --- Exclusions ---
# Library names exactly as they appear in Jellyfin, comma-separated.
EXCLUDE_LIBRARIES=
# Media types to hide: movie, episode, music, livetv, musicvideo, book, trailer ...
EXCLUDE_MEDIA_TYPES=

# --- Behaviour ---
POLL_INTERVAL=15                        # seconds between Jellyfin checks
SHOW_PAUSED=true                        # keep presence up (no progress bar) while paused

# --- Images (asset KEYS uploaded under Developer Portal -> Rich Presence -> Art Assets) ---
STATIC_LARGE_IMAGE=jellyfin             # fallback large image when poster art is unavailable
SMALL_IMAGE_PLAYING=                    # optional small badge, e.g. "playing"
SMALL_IMAGE_PAUSED=                     # optional small badge, e.g. "paused"

LOG_LEVEL=INFO
